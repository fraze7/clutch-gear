generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  MICE
  KEYBOARDS
  HEADSETS
  MOUSEPADS
  ACCESSORIES
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  category    Category
  priceCents  Int
  stock       Int      @default(0)
  imageUrl    String
  featured    Boolean  @default(false)
  // Category-specific details shown on the product page, e.g. { "Weight": "58 g", "Sensor": "..." }
  specs       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([category])
}

enum OrderStatus {
  PENDING // created at checkout, waiting for Stripe
  PAID // confirmed by Stripe (webhook or the return page)
  EXPIRED // the Stripe checkout session expired without payment
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  // Set when a signed-in customer checks out; guest orders have no user
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSessionId String?     @unique
  email           String?
  shippingName    String?
  // The address as Stripe collected it: { line1, line2, city, postal_code, country }
  shippingAddress Json?
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  currency        String      @default("gbp")
  createdAt       DateTime    @default(now())
  paidAt          DateTime?
  items           OrderItem[]

  @@index([status])
  @@index([userId])
}

// A copy of each product's name and price at the time of purchase, so editing or deleting
// a product later never changes an existing order
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug    String
  productName    String
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
}

// ── Better Auth ──────────────────────────────────────────────────────────────
// Core tables from Better Auth's documented schema (https://www.better-auth.com/docs/concepts/database)

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // "customer" or "admin". Better Auth is configured with input: false, so users can never set it themselves
  role          String    @default("customer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
